# Database / Supabase (see project docs)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Session
SESSION_SECRET=

# Public URL of this app (used in quotation and password reset emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: embed TrueType fonts for quotation PDFs (closer match to Word/Acrobat templates).
# On Windows, Arial is auto-detected if unset. On Linux (e.g. Vercel), set paths to .ttf files.
# PDF_BODY_FONT_TTF=
# PDF_BOLD_FONT_TTF=
# PDF_OBLIQUE_FONT_TTF=

# Microsoft Graph email (app-only) — send quotation PDFs to customers
# Azure App Registration required with Mail.Send application permission + admin consent
MS_CLIENT_ID=
MS_TENANT_ID=
MS_CLIENT_SECRET=
# Sender mailbox in your Microsoft 365 tenant (used for /users/{sender}/sendMail)
MS_SENDER_EMAIL=quotes@yourdomain.com

# Xero (server-side only; custom connection or offline token — never expose to the client)
# After EmailQueued/Sent → Approved, creates/finds a Contact and a draft ACCREC invoice.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REFRESH_TOKEN=
XERO_TENANT_ID=
# Chart line defaults (must exist in your Xero org — adjust for AU GST etc.)
XERO_DEFAULT_ACCOUNT_CODE=200
XERO_DEFAULT_TAX_TYPE=OUTPUT
XERO_LINE_AMOUNT_TYPES=Inclusive
